{
  "name": "vattams-abacus-championship",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone online Soroban and Abacus competition platform",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "test:question-redaction": "node scripts/test-question-redaction-contract.mjs",
    "validate:structure": "node scripts/validate-abacus-international-bank.mjs --structure-only",
    "preflight:release": "node scripts/preflight-abacus-release.mjs",
    "test:abacus-snapshot-contract": "node scripts/test-abacus-snapshot-contract.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.8"
  }
}
